generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Entry {
  id         Int      @id @default(autoincrement())
  title      String
  type       String
  director   String
  budget     String?
  location   String?
  duration   String?
  year_time  String?
  poster_url String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
